# SQLite is free and needs no server. Change only if you use another engine later.
DATABASE_URL=sqlite:///./data/bale.db

# Bale credentials — never commit real values.
# Create a temporary bot with BotFather inside Bale, then paste the token here.
BALE_ACCOUNT=
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai
BALE_ADAPTER=http
GROUP_ID=
INVITE_LINK=

INVITE_INTERVAL=5
WORKER_POLL_SECONDS=2
INVITE_STRATEGY=auto
AUTO_INVITE_ON_START=true
INVITE_MESSAGE=سلام همکار گرامی، برای عضویت در گروه از لینک زیر استفاده کنید:\n{invite_link}
BOT_START_MESSAGE=سلام. برای عضویت در گروه همکاران لینک زیر را باز کنید یا شماره خود را ارسال کنید تا شما را اضافه کنیم.\n{invite_link}

# Job queue
MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_DIR=./logs
