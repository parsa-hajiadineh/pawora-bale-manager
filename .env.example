# SQLite is free and needs no server.
DATABASE_URL=sqlite:///./data/bale.db

# telegram = invite by phone (recommended). http = Bale bot (cannot use phone numbers).
MESSENGER_PLATFORM=telegram
BALE_ADAPTER=telegram

# Free Telegram API credentials from https://my.telegram.org  (never commit real values)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_SESSION_PATH=./data/telegram.session

# Target Telegram group: numeric id like -100123... or @username
GROUP_ID=
INVITE_LINK=

# Bale bot (only if MESSENGER_PLATFORM=http)
BALE_ACCOUNT=
BALE_BOT_TOKEN=
BALE_API_BASE_URL=https://tapi.bale.ai

# Seconds between each Telegram API call. Keep this high to avoid flood wait.
INVITE_INTERVAL=20
WORKER_POLL_SECONDS=2
INVITE_STRATEGY=auto
AUTO_INVITE_ON_START=false
INVITE_MESSAGE=سلام همکار گرامی، برای عضویت در گروه از لینک زیر استفاده کنید:\n{invite_link}
BOT_START_MESSAGE=سلام. برای عضویت در گروه همکاران لینک زیر را باز کنید.\n{invite_link}

MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

LOG_LEVEL=INFO
LOG_DIR=./logs
