# SQLite is free and needs no server. Change only if you use another engine later.
DATABASE_URL=sqlite:///./data/bale.db

# Bale credentials — leave empty in phase 1. Never commit real values.
BALE_ACCOUNT=
BALE_BOT_TOKEN=
GROUP_ID=
INVITE_LINK=

# Rate limiting for later Bale operations (seconds)
INVITE_INTERVAL=5

# Job queue
MAX_RETRIES=3
JOB_RETRY_DELAY_SECONDS=60

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_DIR=./logs
